# Strava API application — https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to your host (e.g. localhost, kudex.vercel.app).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# 32+ random chars. Signs session cookies and encrypts stored Strava tokens (AES-256-GCM).
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Public origin used for OAuth redirect + embed URLs. Optional locally (falls back to request origin).
APP_URL=http://localhost:3000

# Upstash Redis / Vercel KV. Leave empty locally to use an in-memory cache. Required in production (the app refuses to start without it).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.

# Strava webhook: any random string. Used once when creating the subscription (see README).
STRAVA_WEBHOOK_VERIFY_TOKEN=
# The "id" Strava returns when you create the subscription. Events without it are ignored,
# so forged webhook calls can't delete or rebuild cards. Required in production.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
